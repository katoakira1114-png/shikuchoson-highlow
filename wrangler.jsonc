{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "shikuchoson-highlow",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "assets": { "directory": "./dist", "binding": "ASSETS", "not_found_handling": "single-page-application", "run_worker_first": ["/api/*"] },
  "durable_objects": {
    "bindings": [
      { "name": "ROOM", "class_name": "Room" },
      { "name": "MATCHMAKER", "class_name": "Matchmaker" }
    ]
  },
  // 無料プランでは SQLite 版の Durable Objects だけが使える
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Room", "Matchmaker"] }]
}
